  "signal_notes": {
    "acceleration": "Use CAN_PB 0x038 IIMULonAccPri as the final acceleration signal, with IIMULonAccPriV from the same frame as validity. ch3 is preferred; ch4/ch2/ch1 are fallback paths when the preferred channel is absent. IIMULonAccPriV == 0 means valid.",
    "ego_speed": "Use CAN_PB 0x209 IVehSpdAvgDrvn_1 as the final ego speed signal, with IVehSpdAvgDrvnV_1 from the same frame as validity. ch3 is preferred; ch4/ch2/ch1 are fallback paths when the preferred channel is absent. IVehSpdAvgDrvnV_1 == 0 means valid.",
    "stationary_state": "IVehMvngStat uses 0=moving and 1=stationary. stationary_flag is true when ego_speed_mps < 0.01 or IVehMvngStat == 1.0.",
